# Explicit trusted numeric export; no download, synthesis or device access.
if(NOT IS_ABSOLUTE "${LAB_VOICE_LOGMEL_ASSETS}")
  message(FATAL_ERROR "Logmel assets require a real absolute directory")
endif()
get_filename_component(_logmel_real "${LAB_VOICE_LOGMEL_ASSETS}" REALPATH)
if(NOT _logmel_real STREQUAL LAB_VOICE_LOGMEL_ASSETS)
  message(FATAL_ERROR "Logmel assets must not follow symlink ancestors")
endif()
foreach(_name decision-metadata.json logmel_model.h logmel_tables.h weights.npz)
  set(_path "${LAB_VOICE_LOGMEL_ASSETS}/${_name}")
  if(NOT EXISTS "${_path}" OR IS_DIRECTORY "${_path}" OR IS_SYMLINK "${_path}")
    message(FATAL_ERROR "Missing or nonregular logmel asset: ${_name}")
  endif()
endforeach()
file(SIZE "${LAB_VOICE_LOGMEL_ASSETS}/decision-metadata.json" _logmel_bytes)
if(_logmel_bytes GREATER 65536)
  message(FATAL_ERROR "Logmel metadata exceeds its byte budget")
endif()
file(READ "${LAB_VOICE_LOGMEL_ASSETS}/decision-metadata.json" _logmel_json)
string(JSON _runtime GET "${_logmel_json}" runtime)
if(NOT _runtime STREQUAL "context-logmel-dscnn-v1")
  message(FATAL_ERROR "Unsupported logmel runtime")
endif()
foreach(_pair "conditioning=hp160" "frontend=context-logmel64" "peak=4096" "samples=32000"
              "rate=16000" "features=2113" "context_frames=10" "duration_scale=4" "time_bins=64"
              "mel_bands=32" "pooling=fractional_frame_overlap" "band_normalization=per_band_mean_divide4"
              "activation=signed_Q5_then_uint8_Q5_ReLU6" "logits=signed_int32_Q10")
  string(REPLACE "=" ";" _parts "${_pair}")
  list(GET _parts 0 _key)
  list(GET _parts 1 _expected)
  string(JSON _actual GET "${_logmel_json}" input_contract "${_key}")
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "Unsupported logmel contract: ${_key}")
  endif()
endforeach()
string(JSON _numeric GET "${_logmel_json}" numeric_bytes)
if(NOT _numeric STREQUAL "23411")
  message(FATAL_ERROR "Fixed 23411-byte numeric architecture required")
endif()
string(JSON _length LENGTH "${_logmel_json}" thresholds_q10)
if(NOT _length EQUAL 5)
  message(FATAL_ERROR "Five logmel thresholds required")
endif()
foreach(_index RANGE 0 4)
  string(JSON _type TYPE "${_logmel_json}" thresholds_q10 ${_index})
  string(JSON _value GET "${_logmel_json}" thresholds_q10 ${_index})
  if(NOT _type STREQUAL "NUMBER" OR NOT _value MATCHES "^[0-9]+$" OR _value GREATER 4096)
    message(FATAL_ERROR "Bounded integer logmel threshold required")
  endif()
endforeach()
file(SIZE "${LAB_VOICE_LOGMEL_ASSETS}/weights.npz" _weight_bytes)
if(_weight_bytes GREATER 262144)
  message(FATAL_ERROR "Bounded logmel numeric archive required")
endif()
string(JSON _expected GET "${_logmel_json}" weights_sha256)
file(SHA256 "${LAB_VOICE_LOGMEL_ASSETS}/weights.npz" _actual)
if(NOT _actual STREQUAL _expected)
  message(FATAL_ERROR "Logmel numeric archive changed")
endif()
foreach(_name logmel_tables.h logmel_model.h)
  string(JSON _expected GET "${_logmel_json}" header_sha256 "${_name}")
  file(SHA256 "${LAB_VOICE_LOGMEL_ASSETS}/${_name}" _actual)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "Logmel header hash changed: ${_name}")
  endif()
endforeach()
file(SHA256 "${LAB_ROOT}/components/voice/logmel_tables.h" _compiled_tables)
string(JSON _exported_tables GET "${_logmel_json}" header_sha256 "logmel_tables.h")
if(NOT _compiled_tables STREQUAL _exported_tables)
  message(FATAL_ERROR "Logmel mathematical tables differ from the compiled tables")
endif()
set(LAB_VOICE_SOURCES
    "${LAB_ROOT}/components/voice/logmel_features.c"
    "${LAB_ROOT}/components/voice/channel_prepare.c"
    "${LAB_ROOT}/components/voice/dscnn.c")
set(LAB_VOICE_LOGMEL_ENABLED TRUE)
