# Optional trusted numeric export. No asset download, generation or device I/O.
if(NOT IS_ABSOLUTE "${LAB_VOICE_CONTEXT_ASSETS}")
  message(FATAL_ERROR "Voice context assets require a real absolute directory")
endif()
get_filename_component(_voice_real "${LAB_VOICE_CONTEXT_ASSETS}" REALPATH)
if(NOT _voice_real STREQUAL LAB_VOICE_CONTEXT_ASSETS)
  message(FATAL_ERROR "Voice context assets must not follow symlink ancestors")
endif()
foreach(_name decision-metadata.json decision_model.h feature_tables.h)
  set(_path "${LAB_VOICE_CONTEXT_ASSETS}/${_name}")
  if(NOT EXISTS "${_path}" OR IS_DIRECTORY "${_path}" OR IS_SYMLINK "${_path}")
    message(FATAL_ERROR "Missing or nonregular voice context asset: ${_name}")
  endif()
endforeach()
file(SIZE "${LAB_VOICE_CONTEXT_ASSETS}/decision-metadata.json" _voice_bytes)
if(_voice_bytes GREATER 65536)
  message(FATAL_ERROR "Voice metadata exceeds its byte budget")
endif()
file(READ "${LAB_VOICE_CONTEXT_ASSETS}/decision-metadata.json" _voice_json)
string(JSON _runtime GET "${_voice_json}" runtime)
if(NOT _runtime STREQUAL "context-duration-class-v1")
  message(FATAL_ERROR "Unsupported voice context runtime")
endif()
foreach(_pair "conditioning=hp160" "frontend=context-duration" "peak=4096" "samples=32000"
              "rate=16000" "features=261" "context_frames=10" "duration_scale=4")
  string(REPLACE "=" ";" _parts "${_pair}")
  list(GET _parts 0 _key)
  list(GET _parts 1 _expected)
  string(JSON _actual GET "${_voice_json}" input_contract "${_key}")
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "Unsupported voice context contract: ${_key}")
  endif()
endforeach()
string(JSON _length LENGTH "${_voice_json}" thresholds_q10)
if(NOT _length EQUAL 5)
  message(FATAL_ERROR "Five voice rejection thresholds required")
endif()
foreach(_index RANGE 0 4)
  string(JSON _type TYPE "${_voice_json}" thresholds_q10 ${_index})
  string(JSON _value GET "${_voice_json}" thresholds_q10 ${_index})
  if(NOT _type STREQUAL "NUMBER" OR NOT _value MATCHES "^[0-9]+$" OR _value GREATER 4096)
    message(FATAL_ERROR "Bounded integer voice threshold required")
  endif()
endforeach()
foreach(_name feature_tables.h decision_model.h)
  string(JSON _expected GET "${_voice_json}" header_sha256 "${_name}")
  file(SHA256 "${LAB_VOICE_CONTEXT_ASSETS}/${_name}" _actual)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "Voice context header hash changed: ${_name}")
  endif()
endforeach()
# Quoted includes in the frozen C source use this shared table first.
file(SHA256 "${LAB_ROOT}/components/voice/feature_tables.h" _shared_tables)
string(JSON _exported_tables GET "${_voice_json}" header_sha256 "feature_tables.h")
if(NOT _shared_tables STREQUAL _exported_tables)
  message(FATAL_ERROR "Voice context mathematical tables differ from the compiled tables")
endif()
set(LAB_VOICE_SOURCES
    "${LAB_ROOT}/components/voice/decision_features.c"
    "${LAB_ROOT}/components/voice/channel_prepare.c"
    "${LAB_ROOT}/components/voice/decision_inference.c")
set(LAB_VOICE_CONTEXT_ENABLED TRUE)
